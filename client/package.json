{
  "name": "syncplane",
  "version": "0.4.0",
  "description": "Local-read/local-write sync client with optimistic rebase (ESM-only)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LevelFourAB/syncplane.git",
    "directory": "client"
  },
  "homepage": "https://github.com/LevelFourAB/syncplane#readme",
  "bugs": "https://github.com/LevelFourAB/syncplane/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./tunnel": {
      "types": "./dist/tunnel/index.d.ts",
      "default": "./dist/tunnel/index.js"
    },
    "./gen/*": "./dist/gen/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:react": "vitest run --project react",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:install": "playwright install chromium",
    "bench:browser": "playwright test --config playwright.bench.config.ts --project=chrome"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@connectrpc/connect": "^2.1.0",
    "@connectrpc/connect-web": "^2.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@connectrpc/connect-node": "^2.1.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.5",
    "vitest": "^3.2.0"
  }
}
