		{
			"name": "a permission held at the root reaches every row",
			"access": {
				"view_tasks": {
					"root": true
				}
			},
			"permission": "view_tasks",
			"entity": "task",
			"key": "t1",
			"chain": [
				{
					"entity": "project",
					"key": "p1"
				}
			],
			"want": "yes"
		},
		{
